# Public Supabase client configuration (safe for the browser).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Use the project's anon key or the newer publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key

# Collaboration WebSocket URL (browser). Point at the separately hosted Hocuspocus service.
# Local default: ws://127.0.0.1:1234
NEXT_PUBLIC_COLLAB_WS_URL=ws://127.0.0.1:1234

# Optional aliases (unsupported by the app directly — prefer the vars above).
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose to the browser. Never commit real values.
# Used by the collaboration service (and optional admin tooling), not the Next.js client bundle.
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=

# Collaboration service (also see collaboration/.env.example)
# COLLAB_PORT=1234
# COLLAB_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Production collab project also needs:
# REDIS_URL=redis://...   (cross-instance Yjs sync on Vercel)
# COLLAB_REQUIRE_REDIS=true
# COLLAB_ALLOWED_ORIGINS=https://YOUR_WEB_PROJECT.vercel.app

# Optional: used by migration/seed tooling only (not read by the Next.js app).
# DIRECT_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
